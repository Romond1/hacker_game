{
  "name": "be-a-hero-hacker-training",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prepare-deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false",
    "check:server-contract": "node scripts/check-server-contract.mjs",
    "setup:dev-auth": "node scripts/setup-dev-auth.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "latest",
    "jsdom": "27.4.0",
    "vitest": "latest"
  }
}
